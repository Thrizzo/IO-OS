[General]
# IO Linux — light variant of the IO color scheme.
# Hex equivalents (mirror branding/colors/IO.colors dark variant; backgrounds
# are inverted, accent is darkened slightly so it stays readable on white):
#   #F5F5F7  = 245,245,247    primary background (off-white)
#   #E8E8EC  = 232,232,236    raised surface
#   #DCDCE2  = 220,220,226    alt surface
#   #B88A37  = 184,138, 55    accent (darker amber for contrast)
#   #D4A24A  = 212,162, 74    accent hover (matches dark variant)
#   #1E2028  =  30, 32, 40    foreground / text
#   #5C6270  =  92, 98,112    disabled / secondary text
Name=IO Light
shadeSortColumn=true

[ColorEffects:Disabled]
Color=200,200,205
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.10
IntensityEffect=2

