# systemd unit (system-level) that installs the IO default Flatpaks on
# first boot. Runs once after network-online; disables itself when the
# install completes so subsequent boots are no-ops.
#
# Why on first boot rather than baked into the ISO: Flathub flatpaks are
# big (Brave + Thunderbird ~ 700 MB combined). Putting them in the ISO
# would push the image past the size budget for a USB-stick install.
# The trade-off is a one-time online install; offline installs can drop
# a /etc/flatpak/installations.d/ stub that points at a local mirror.

[Unit]
Description=Install IO default Flatpaks (Brave, Thunderbird)
ConditionPathExists=!/var/lib/io-firstboot-flatpak.done
After=network-online.target NetworkManager-wait-online.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/bin/sh -c 'flatpak remote-add --if-not-exists --system flathub https://dl.flathub.org/repo/flathub.flatpakrepo'
ExecStart=/bin/sh -c 'flatpak install -y --noninteractive --system flathub com.brave.Browser org.mozilla.Thunderbird || exit 1'
ExecStartPost=/bin/touch /var/lib/io-firstboot-flatpak.done
TimeoutStartSec=600
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
