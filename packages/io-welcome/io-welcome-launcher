#!/usr/bin/env bash
# Launcher for io-welcome.
#
# Skips silently if the user has opted out previously. Otherwise runs
# the QML app via whichever Qt6 qml runtime is on PATH and persists the
# opt-out if the app exited with code 42.

set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/io-welcome"
DISABLED="$CONFIG_DIR/disabled"
QML_FILE="/usr/share/io-welcome/Main.qml"

# Already opted out? Done.
[ -f "$DISABLED" ] && exit 0

# Find a Qt6 qml runtime. openSUSE ships it as either `qml6` or `qml` in
# /usr/bin (qt6-declarative-tools / qt6-tools).
QML_BIN=""
for candidate in qml6 qml; do
    if command -v "$candidate" >/dev/null 2>&1; then
        QML_BIN=$(command -v "$candidate")
        break
    fi
done

# Surface install issues via the desktop notification stack so users notice
# instead of silently missing the welcome screen. kdialog is part of every
# Plasma install; if it's also missing we fall back to stderr.
notify() {
    if command -v kdialog >/dev/null 2>&1; then
        kdialog --title "IO Welcome" --passivepopup "$1" 5 || true
    fi
    echo "io-welcome: $1" >&2
}

if [ -z "$QML_BIN" ]; then
    notify "no qml runtime found on PATH; skipping."
    exit 0
fi

if [ ! -f "$QML_FILE" ]; then
    notify "$QML_FILE not installed; skipping."
    exit 0
fi

# Disable -e around the QML runtime so we can read its exit code; pipefail
# is harmless here (no pipeline) and stays on for any future additions.
status=0
"$QML_BIN" "$QML_FILE" || status=$?

# 42 = user ticked "don't show on next start" before closing.
if [ "$status" = "42" ]; then
    mkdir -p "$CONFIG_DIR"
    touch "$DISABLED"
fi

exit 0
