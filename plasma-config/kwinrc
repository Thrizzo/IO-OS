# KWin defaults shipped to /etc/skel/.config/.
# Each override exists to reduce the gap for users coming from Windows.

[org.kde.kdecoration2]
# Match Windows: minimise / maximise / close on the right, no menu/help/keep.
ButtonsOnLeft=
ButtonsOnRight=IAX
library=org.kde.breeze
theme=Breeze

[Windows]
# Click-to-focus is what Windows users expect; focus-follows-mouse is alien to them.
FocusPolicy=ClickToFocus
# A clicked window comes to the front — also matches Windows.
ClickRaise=true
AutoRaise=false

[Compositing]
# Keep compositing on (Plasma defaults). Disabling it silently breaks too much.
Enabled=true
OpenGLIsUnsafe=false

[Windows]
# (continued from above) Snap-on-edge: dragging a window to a screen edge
# tiles it, mirroring Windows 7+ Aero Snap. ElectricBorders=1 means active
# only when the window is actually being dragged.
ElectricBorders=1
ElectricBorderCornerRatio=0.25
ElectricBorderDelay=150

[Plugins]
# Overview = Win+Tab task view; bind in kglobalshortcutsrc.
overviewEnabled=true
# Subtle window minimise / maximise animation, like Windows DWM.
slideEnabled=true
# Highlight focused window briefly when alt-tabbing, mirrors Windows.
highlightwindowEnabled=true

[TabBox]
# Alt+Tab uses thumbnail grid layout — closest to Windows' alt-tab UI.
LayoutName=thumbnail_grid
HighlightWindows=true
ShowDesktopMode=DoNotShowDesktopClient
ShowTabBox=true
